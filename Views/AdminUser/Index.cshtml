@* Đặt tại: Views/AdminUser/Index.cshtml (hoặc CandidateDashboard.cshtml) *@
@model IEnumerable<HeThongTimViec.Models.NguoiDung>
@using HeThongTimViec.Models
@using HeThongTimViec.Controllers 
@using System.Text.Json            

@{
    ViewData["Title"] = "Quản lý người dùng";
    Layout = "_LayoutAdmin"; // Đảm bảo đây là layout admin chính xác của bạn

    // Lấy các giá trị bộ lọc từ ViewData để dễ sử dụng
    var searchString = ViewData["CurrentSearch"] as string;
    var roleFilter = ViewData["CurrentRole"] as LoaiTaiKhoan?;
    var statusFilter = ViewData["CurrentStatus"] as TrangThaiTaiKhoan?;
    var startDate = ViewData["CurrentStartDate"] as string; // Giữ dạng string để đưa vào input date
    var endDate = ViewData["CurrentEndDate"] as string;   // Giữ dạng string để đưa vào input date

    // Giá trị phân trang
    var pageNumber = (int)(ViewData["PageNumber"] ?? 1); // Mặc định là 1 nếu null
    var totalPages = (int)(ViewData["TotalPages"] ?? 0);
    var totalUsers = (int)(ViewData["TotalUsers"] ?? 0); // Tổng số người dùng sau khi lọc
    var pageSize = (int)(ViewData["PageSize"] ?? 10); // Mặc định page size nếu null
    var startIndex = totalUsers > 0 ? (pageNumber - 1) * pageSize + 1 : 0;
    var endIndex = totalUsers > 0 ? Math.Min(startIndex + pageSize - 1, totalUsers) : 0;

    // Chế độ xem hiện tại (mặc định là table)
    var currentViewMode = (ViewBag.ViewMode as string ?? "table").ToLowerInvariant();

    // Kiểm tra Model có dữ liệu không
    var hasUsers = Model != null && Model.Any();

    // --- Chuẩn bị Route Data cho các Link ---
    var baseRouteData = new Dictionary<string, string?>
    {
        { "searchString", searchString },
        { "roleFilter", roleFilter?.ToString() },
        { "statusFilter", statusFilter?.ToString() },
        { "startDate", startDate },
        { "endDate", endDate },
        { "pageNumber", pageNumber.ToString() },
        { "viewMode", currentViewMode }
    };
    var finalRouteData = baseRouteData
        .Where(kvp => !string.IsNullOrEmpty(kvp.Value))
        .ToDictionary(kvp => kvp.Key, kvp => kvp.Value!);
    var tableViewRouteData = new Dictionary<string, string>(finalRouteData) { ["viewMode"] = "table" };
    var gridViewRouteData = new Dictionary<string, string>(finalRouteData) { ["viewMode"] = "grid" };
    var clearFilterRouteData = new Dictionary<string, string> { { "viewMode", currentViewMode } };
}

<style>
    /* Style cơ bản cho avatar tròn */
    .avatar-circle {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        background-color: #6c757d; /* Màu xám mặc định */
        color: white;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        margin-right: 8px;
        font-size: 0.9rem;
        text-transform: uppercase;
        flex-shrink: 0; /* Ngăn avatar bị co lại */
    }
    /* Avatar lớn hơn cho card */
    .avatar-circle-lg {
        width: 50px;
        height: 50px;
        font-size: 1.2rem;
    }


    .user-info .name {
        font-weight: 500;
        color: #333; /* Màu chữ đậm hơn */
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis; /* Thêm dấu ... nếu tên quá dài */
        max-width: 180px; /* Giới hạn chiều rộng tên */
        display: inline-block; /* Cần thiết cho max-width */
        vertical-align: middle;
    }
    /* Đảm bảo link trong tên có màu và gạch chân khi hover */
    .user-info .name a, .user-card .card-title a {
        color: #4e73df; /* Màu primary của SB Admin */
        text-decoration: none;
        font-weight: 500; /* Giữ đậm */
    }
    .user-info .name a:hover, .user-card .card-title a:hover {
         text-decoration: underline;
     }

    .user-info .location,
    .user-info .email-phone small {
        font-size: 0.85rem;
        color: #6c757d;
    }
     .user-card .card-text {
          font-size: 0.9rem;
          color: #5a5c69;
      }
      .user-card .card-text .fa-fw {
         width: 1.2em; /* Tăng khoảng cách icon */
      }

    .table th, .table td {
        vertical-align: middle;
        padding: 0.6rem 0.75rem; /* Điều chỉnh padding */
    }

    .filter-section .form-label {
        font-size: 0.85rem;
        margin-bottom: 0.2rem;
    }

    .action-dropdown .dropdown-menu {
        min-width: 180px; /* Tăng chiều rộng dropdown */
        box-shadow: 0 0.5rem 1rem rgba(0,0,0,.15)!important;
    }
    /* Đảm bảo nút dropdown item hoạt động như link */
    .action-dropdown .dropdown-item {
        cursor: pointer;
    }
     /* Style cho nút submit trong dropdown */
    .action-dropdown .dropdown-item-form button {
        background: none;
        border: none;
        padding: 0.25rem 1rem; /* Giống padding dropdown-item */
        width: 100%;
        text-align: left;
        color: var(--bs-dropdown-link-color); /* Màu mặc định của link */
        font-size: inherit;
        display: flex; /* Để icon và text thẳng hàng */
        align-items: center;
    }
    .action-dropdown .dropdown-item-form button:hover {
        background-color: var(--bs-dropdown-link-hover-bg);
        color: var(--bs-dropdown-link-hover-color);
    }
    .action-dropdown .dropdown-item-form button.text-success:hover { color: #157347 !important; } /* Đậm hơn khi hover */
    .action-dropdown .dropdown-item-form button.text-danger:hover { color: #a0271b !important; } /* Đậm hơn khi hover */
    .action-dropdown .dropdown-item-form button.text-warning:hover { color: #c79a21 !important; } /* Đậm hơn khi hover */
    .action-dropdown .dropdown-item.disabled,
    .action-dropdown .dropdown-item-form button:disabled {
        color: var(--bs-dropdown-link-disabled-color);
        pointer-events: none;
        background-color: transparent;
    }

    .badge {
        font-size: 0.78em;
        padding: 0.4em 0.6em;
        font-weight: 500;
    }

    /* Styles cho thẻ thống kê (dựa trên SB Admin 2) - Giữ nguyên */
     .card.border-left-primary { border-left: .25rem solid #4e73df!important; }
     .card.border-left-success { border-left: .25rem solid #1cc88a!important; }
     .card.border-left-info { border-left: .25rem solid #36b9cc!important; }
     .card.border-left-warning { border-left: .25rem solid #f6c23e!important; }
     .card.border-left-danger { border-left: .25rem solid #e74a3b!important; }

     .text-xs { font-size: .75rem; letter-spacing: 0.05rem;}
     .text-gray-300 { color: #dddfeb!important; }
     .text-gray-800 { color: #5a5c69!important; }
     .font-weight-bold { font-weight: 700!important; }
     .h5, h5 { font-size: 1.25rem; }
     .card .card-body { padding: 1rem; } /* Điều chỉnh padding body card */
     .no-gutters { margin-right: 0; margin-left: 0; }
     .no-gutters > .col, .no-gutters > [class*=col-] { padding-right: 0; padding-left: 0; }

     /* Nút dropdown nhỏ hơn */
      .action-dropdown .btn-outline-secondary {
        padding: 0.1rem 0.4rem;
        font-size: 0.8rem;
        border: none; /* Bỏ viền cho đẹp hơn */
      }
      .action-dropdown .fa-ellipsis-v {
         color: #858796; /* Màu icon xám hơn */
      }
       .action-dropdown .btn-outline-secondary:focus {
            box-shadow: none; /* Bỏ focus ring */
       }

     /* Style cho card người dùng trong chế độ lưới */
     .user-card .card-body {
         padding: 1.25rem;
         display: flex; /* Để đẩy action buttons xuống */
         flex-direction: column;
     }
     .user-card .action-buttons {
         padding-top: 0.75rem;
         margin-top: auto; /* Quan trọng: Đẩy khối này xuống cuối */
         border-top: 1px solid #e3e6f0; /* Đường kẻ phân cách */
         display: flex; /* Sắp xếp nút */
         justify-content: flex-end; /* Căn phải */
         gap: 0.5rem; /* Khoảng cách giữa các nút */
     }
     .user-card .action-buttons .btn,
     .user-card .action-buttons form button { /* Áp dụng cho cả nút trong form */
         padding: 0.25rem 0.6rem; /* Nút nhỏ hơn */
         font-size: 0.875rem; /* Cỡ chữ nút nhỏ */
     }
      .user-card .action-buttons form {
          display: inline-block; /* Giữ form trên một hàng */
      }
     /* Hiển thị hover nhẹ cho card */
    .user-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 0.5rem 1rem rgba(0,0,0,.1) !important;
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

    /* Helper class để làm nút nhỏ hơn (ví dụ: nút verify cạnh status badge) */
    .btn-xs {
        padding: 0.1rem 0.3rem;
        font-size: 0.75rem;
        line-height: 1.2;
    }
    .btn-xs i { /* Điều chỉnh icon trong nút xs */
        font-size: 0.8em;
        vertical-align: middle;
    }

</style>

<div class="container-fluid mt-4">

    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">@ViewData["Title"]</h1>
        <div>
            <a asp-controller="AdminUser" asp-action="Create" class="btn btn-primary btn-sm shadow-sm">
                <i class="fas fa-plus fa-sm me-1"></i> Thêm người dùng
            </a>
        </div>
    </div>

    <!-- Hiển thị thông báo (Success, Error, Warning) -->
    @if (!string.IsNullOrEmpty(TempData["SuccessMessage"] as string)) {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(TempData["ErrorMessage"] as string)) {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
             <i class="fas fa-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(TempData["WarningMessage"] as string)) {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i> @TempData["WarningMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
     @if (!string.IsNullOrEmpty(TempData["InfoMessage"] as string)) {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="fas fa-info-circle me-2"></i> @TempData["InfoMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }


    <!-- Hàng Thống kê -->
    @if (ViewBag.TotalUserCount != null)
    {
        <div class="row mb-4">
            <!-- Tổng người dùng Card -->
             <div class="col-xl-3 col-md-6 mb-4">
                 <div class="card border-left-primary shadow h-100 py-2">
                     <div class="card-body">
                         <div class="row no-gutters align-items-center">
                             <div class="col mr-2">
                                 <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Tổng người dùng</div>
                                 <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewBag.TotalUserCount</div>
                                 @{ var userGrowth = Convert.ToDouble(ViewBag.UserGrowthPercentage ?? 0.0); }
                                 <small class="text-muted @(userGrowth >= 0 ? "text-success" : "text-danger")">
                                     <i class="fas @(userGrowth >= 0 ? "fa-arrow-up" : "fa-arrow-down")"></i>
                                     @($"{userGrowth:F1}%") so với tháng trước
                                 </small>
                             </div>
                             <div class="col-auto"><i class="fas fa-users fa-2x text-gray-300"></i></div>
                         </div>
                     </div>
                 </div>
             </div>
             <!-- Ứng viên Card -->
             <div class="col-xl-3 col-md-6 mb-4">
                 <div class="card border-left-success shadow h-100 py-2">
                     <div class="card-body">
                         <div class="row no-gutters align-items-center">
                             <div class="col mr-2">
                                 <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Cá nhân (Ứng viên)</div>
                                 <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewBag.CandidateCount</div>
                                 @{ var candidateGrowth = Convert.ToDouble(ViewBag.CandidateGrowthPercentage ?? 0.0); }
                                 <small class="text-muted @(candidateGrowth >= 0 ? "text-success" : "text-danger")">
                                      <i class="fas @(candidateGrowth >= 0 ? "fa-arrow-up" : "fa-arrow-down")"></i>
                                     @($"{candidateGrowth:F1}%") so với tháng trước
                                 </small>
                             </div>
                             <div class="col-auto"><i class="fas fa-user-tie fa-2x text-gray-300"></i></div>
                         </div>
                     </div>
                 </div>
             </div>
             <!-- Nhà tuyển dụng Card -->
             <div class="col-xl-3 col-md-6 mb-4">
                 <div class="card border-left-info shadow h-100 py-2">
                     <div class="card-body">
                         <div class="row no-gutters align-items-center">
                             <div class="col mr-2">
                                 <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Doanh nghiệp (NTD)</div>
                                 <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewBag.EmployerCount</div>
                                  @{ var employerGrowth = Convert.ToDouble(ViewBag.EmployerGrowthPercentage ?? 0.0); }
                                  <small class="text-muted @(employerGrowth >= 0 ? "text-success" : "text-danger")">
                                       <i class="fas @(employerGrowth >= 0 ? "fa-arrow-up" : "fa-arrow-down")"></i>
                                      @($"{employerGrowth:F1}%") so với tháng trước
                                  </small>
                             </div>
                             <div class="col-auto"><i class="fas fa-building fa-2x text-gray-300"></i></div>
                         </div>
                     </div>
                 </div>
             </div>
             <!-- Tài khoản bị cấm Card -->
             <div class="col-xl-3 col-md-6 mb-4">
                 <div class="card border-left-danger shadow h-100 py-2">
                     <div class="card-body">
                         <div class="row no-gutters align-items-center">
                             <div class="col mr-2">
                                 <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Tài khoản bị cấm</div>
                                 <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewBag.BannedCount</div>
                                 <small class="text-muted">
                                    <span class="text-danger">@ViewBag.NewlyBannedCount</span> mới trong tháng này
                                </small>
                             </div>
                             <div class="col-auto"><i class="fas fa-user-slash fa-2x text-gray-300"></i></div>
                         </div>
                     </div>
                 </div>
             </div>
         </div>
    }
    <!-- / Hàng Thống kê -->


    <!-- Card Bộ lọc -->
    <div class="card shadow mb-4">
        <a href="#collapseFilterCard" class="d-block card-header py-3" data-bs-toggle="collapse" role="button" aria-expanded="true" aria-controls="collapseFilterCard">
             <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-filter me-2"></i>Bộ lọc tìm kiếm</h6>
        </a>
        <div class="collapse show" id="collapseFilterCard">
            <div class="card-body filter-section">
                 <form asp-controller="AdminUser" asp-action="Index" method="get" class="row g-3 align-items-end">
                     <input type="hidden" name="viewMode" value="@currentViewMode" />
                    <div class="col-lg-3 col-md-6">
                        <label for="searchString" class="form-label">Tìm kiếm</label>
                        <input type="search" id="searchString" name="searchString" value="@searchString" class="form-control form-control-sm" placeholder="Nhập tên hoặc email...">
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <label for="roleFilter" class="form-label">Vai trò</label>
                        <select id="roleFilter" name="roleFilter" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<LoaiTaiKhoan>().Where(i => i.Value != ((int)LoaiTaiKhoan.quantrivien).ToString())" asp-for="@roleFilter">
                             <option value="">-- Tất cả vai trò --</option>
                        </select>
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <label for="statusFilter" class="form-label">Trạng thái</label>
                        <select id="statusFilter" name="statusFilter" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<TrangThaiTaiKhoan>()" asp-for="@statusFilter">
                            <option value="">-- Tất cả trạng thái --</option>
                        </select>
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <label for="startDate" class="form-label">Ngày tạo từ</label>
                        <input type="date" id="startDate" name="startDate" value="@startDate" class="form-control form-control-sm" title="Ngày tạo từ">
                    </div>
                    <div class="col-lg-2 col-md-6">
                        <label for="endDate" class="form-label">Ngày tạo đến</label>
                        <input type="date" id="endDate" name="endDate" value="@endDate" class="form-control form-control-sm" title="Ngày tạo đến">
                    </div>
                    <div class="col-lg-1 col-md-6 text-lg-end mt-3 mt-lg-0">
                        <button type="submit" class="btn btn-info btn-sm w-100"><i class="fas fa-search me-1"></i> Lọc</button>
                    </div>
                    <div class="col-lg-auto col-md-6 mt-3 mt-lg-0">
                        <a asp-controller="AdminUser" asp-action="Index" asp-all-route-data="clearFilterRouteData" class="btn btn-outline-secondary btn-sm w-100"><i class="fas fa-times me-1"></i> Xóa lọc</a>
                    </div>
                </form>
            </div>
        </div>
    </div><!-- / Card Bộ lọc -->

    <!-- Card Hiển thị dữ liệu -->
    <div class="card shadow mb-4">
         <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
              <h6 class="m-0 font-weight-bold text-primary">Danh sách người dùng (@totalUsers tìm thấy)</h6>
               <div class="btn-group btn-group-sm" role="group" aria-label="View mode toggle">
                    <a asp-controller="AdminUser" asp-action="Index" asp-all-route-data="@tableViewRouteData"
                       class="btn @(currentViewMode == "table" ? "btn-primary active" : "btn-outline-secondary")"
                       title="Xem dạng bảng">
                       <i class="fas fa-list"></i>
                    </a>
                    <a asp-controller="AdminUser" asp-action="Index" asp-all-route-data="@gridViewRouteData"
                       class="btn @(currentViewMode == "grid" ? "btn-primary active" : "btn-outline-secondary")"
                       title="Xem dạng lưới">
                       <i class="fas fa-th-large"></i>
                    </a>
                </div>
         </div>

         @if (currentViewMode == "grid")
         {
             <div class="card-body">
                 <div class="row g-3">
                      @if (hasUsers)
                      {
                          @foreach (var item in Model)
                          {
                              var statusInfo = AdminUserController.GetTrangThaiDisplay(item.TrangThaiTk);
                              var roleText = AdminUserController.GetVaiTroDisplay(item.LoaiTk);
                              var initials = "?";
                              if (!string.IsNullOrWhiteSpace(item.HoTen)) {
                                   var nameParts = item.HoTen.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
                                   if (nameParts.Length > 1) initials = $"{nameParts[0][0]}{nameParts.Last()[0]}".ToUpper();
                                   else if (nameParts.Length == 1 && nameParts[0].Length > 0) initials = $"{nameParts[0][0]}".ToUpper();
                              }

                              <div class="col-12 col-md-6 col-lg-4 d-flex">
                                 <div class="card shadow-sm h-100 user-card w-100">
                                     <div class="card-body">
                                         <div class="d-flex align-items-center mb-3">
                                             <span class="avatar-circle avatar-circle-lg me-3 flex-shrink-0" title="@item.HoTen">@initials</span>
                                             <div style="min-width: 0;">
                                                 <h6 class="card-title mb-0 text-truncate">
                                                     <a asp-controller="AdminUser" asp-action="Details" asp-route-id="@item.Id" title="Xem chi tiết @item.HoTen">@item.HoTen</a>
                                                 </h6>
                                                 @if(item.ThanhPho != null) {
                                                     <small class="text-muted d-block text-truncate"><i class="fas fa-map-marker-alt fa-xs me-1"></i>@item.ThanhPho.Ten</small>
                                                 } else {
                                                     <small class="text-muted d-block"><i>(Chưa có vị trí)</i></small>
                                                 }
                                             </div>
                                         </div>
                                         <p class="card-text small mb-1 text-truncate" title="@item.Email">
                                             <i class="far fa-envelope fa-fw me-1 text-muted"></i> @item.Email
                                         </p>
                                         @if(!string.IsNullOrWhiteSpace(item.Sdt)) {
                                             <p class="card-text small mb-2"><i class="fas fa-phone fa-fw me-1 text-muted"></i> @item.Sdt</p>
                                         } else {
                                              <p class="card-text small mb-2 text-muted"><i class="fas fa-phone fa-fw me-1"></i> <i>(Chưa có SĐT)</i></p>
                                         }
                                         <div class="mb-3">
                                             <span class="me-2" title="Vai trò"><i class="fas fa-user-tag fa-fw me-1 text-muted"></i>@roleText</span>
                                             <span class="@statusInfo.BadgeClass me-1" title="Trạng thái">@statusInfo.Text</span>
                                              @if (item.LoaiTk == LoaiTaiKhoan.doanhnghiep && item.TrangThaiTk == TrangThaiTaiKhoan.choxacminh)
                                              {
                                                   <form asp-controller="AdminUser" asp-action="VerifyBusiness" asp-route-userId="@item.Id" method="post"
                                                         onsubmit="return confirm('Xác minh doanh nghiệp [' + @Json.Serialize(item.HoTen) + ']?');" class="d-inline align-middle">
                                                       @Html.AntiForgeryToken()
                                                       <input type="hidden" name="viewMode" value="grid" />
                                                       <button type="submit" class="btn btn-xs btn-outline-warning p-0 px-1" title="Xác minh doanh nghiệp"><i class="fas fa-user-check fa-xs"></i></button>
                                                   </form>
                                              }
                                         </div>
                                         <div class="action-buttons">
                                              <a asp-controller="AdminUser" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Xem chi tiết"><i class="fas fa-eye"></i></a>
                                               @* SỬA: Bỏ class 'disabled' và cập nhật title *@
                                               <a asp-controller="AdminUser" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Sửa người dùng"><i class="fas fa-edit"></i></a>
                                              @if (item.LoaiTk != LoaiTaiKhoan.quantrivien)
                                              {
                                                  if (item.TrangThaiTk == TrangThaiTaiKhoan.bidinhchi) {
                                                      <form asp-controller="AdminUser" asp-action="Unban" asp-route-id="@item.Id" method="post"
                                                            onsubmit="return confirm('Kích hoạt lại người dùng [' + @Json.Serialize(item.HoTen) + ']?');">
                                                          @Html.AntiForgeryToken()
                                                          <input type="hidden" name="viewMode" value="grid" />
                                                          <button type="submit" class="btn btn-sm btn-outline-success" title="Kích hoạt lại"><i class="fas fa-check-circle"></i></button>
                                                      </form>
                                                  } else {
                                                      <form asp-controller="AdminUser" asp-action="Ban" asp-route-id="@item.Id" method="post"
                                                            onsubmit="return confirm('Cấm người dùng [' + @Json.Serialize(item.HoTen) + ']?');">
                                                          @Html.AntiForgeryToken()
                                                          <input type="hidden" name="viewMode" value="grid" />
                                                          <button type="submit" class="btn btn-sm btn-outline-danger" title="Cấm tài khoản"><i class="fas fa-ban"></i></button>
                                                      </form>
                                                  }
                                                   @* XÓA: Bỏ class 'disabled' và cập nhật title *@
                                                   <a asp-controller="AdminUser" asp-action="Delete" asp-route-id="@item.Id" asp-route-viewMode="grid" class="btn btn-sm btn-outline-danger" title="Xóa người dùng">
                                                       <i class="fas fa-trash-alt"></i>
                                                   </a>
                                              }
                                          </div>
                                     </div>
                                 </div>
                             </div>
                          }
                      }
                       else {
                          <div class="col-12">
                              <div class="text-center py-5 text-muted">
                                  <i class="fas fa-users-slash fa-3x mb-3"></i><br>
                                  Không tìm thấy người dùng nào phù hợp với bộ lọc hiện tại.
                              </div>
                          </div>
                      }
                 </div><!-- /.row -->
             </div><!-- /.card-body grid -->
         }
         else // Chế độ xem Bảng (Table)
         {
             <div class="card-body p-0">
                 <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                               <th style="width: 5%;">ID</th>
                               <th style="width: 25%;">Tên người dùng</th>
                               <th style="width: 25%;">Liên hệ</th>
                               <th style="width: 15%;">Vai trò</th>
                               <th style="width: 15%;">Trạng thái</th>
                               <th style="width: 10%;">Ngày tạo</th>
                               <th style="width: 5%;" class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (hasUsers)
                            {
                                @foreach (var item in Model)
                                {
                                    var statusInfo = AdminUserController.GetTrangThaiDisplay(item.TrangThaiTk);
                                    var roleText = AdminUserController.GetVaiTroDisplay(item.LoaiTk);
                                    var initials = "?";
                                    if (!string.IsNullOrWhiteSpace(item.HoTen)) {
                                         var nameParts = item.HoTen.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
                                         if (nameParts.Length > 1) initials = $"{nameParts[0][0]}{nameParts.Last()[0]}".ToUpper();
                                         else if (nameParts.Length == 1 && nameParts[0].Length > 0) initials = $"{nameParts[0][0]}".ToUpper();
                                    }
                                    <tr>
                                        <td>@item.Id</td>
                                        <td>
                                            <div class="d-flex align-items-center user-info">
                                                <span class="avatar-circle me-2 flex-shrink-0" title="@item.HoTen">@initials</span>
                                                <div style="min-width: 0;">
                                                    <div class="name"><a asp-controller="AdminUser" asp-action="Details" asp-route-id="@item.Id" title="Xem chi tiết @item.HoTen">@item.HoTen</a></div>
                                                    @if(item.ThanhPho != null) {
                                                        <div class="location"><i class="fas fa-map-marker-alt fa-xs me-1"></i>@item.ThanhPho.Ten</div>
                                                    } else {
                                                        <small class="text-muted"><i>(Chưa có vị trí)</i></small>
                                                    }
                                                </div>
                                            </div>
                                        </td>
                                        <td class="user-info email-phone">
                                            <div class="text-truncate" title="@item.Email"><i class="far fa-envelope fa-xs me-1"></i> @item.Email</div>
                                            @if(!string.IsNullOrWhiteSpace(item.Sdt)) {
                                                <small class="text-muted d-block"><i class="fas fa-phone fa-xs me-1"></i> @item.Sdt</small>
                                            } else {
                                                <small class="text-muted d-block"><i>(Chưa có SĐT)</i></small>
                                            }
                                        </td>
                                        <td>@roleText</td>
                                        <td>
                                            <span class="@statusInfo.BadgeClass me-1">@statusInfo.Text</span>
                                            @if (item.LoaiTk == LoaiTaiKhoan.doanhnghiep && item.TrangThaiTk == TrangThaiTaiKhoan.choxacminh) {
                                                <form asp-controller="AdminUser" asp-action="VerifyBusiness" asp-route-userId="@item.Id" method="post"
                                                      onsubmit="return confirm('Xác minh doanh nghiệp [' + @Json.Serialize(item.HoTen) + ']?');" class="d-inline align-middle">
                                                      @Html.AntiForgeryToken()
                                                      <input type="hidden" name="viewMode" value="table" />
                                                      <button type="submit" class="btn btn-xs btn-outline-warning p-0 px-1" title="Xác minh doanh nghiệp"><i class="fas fa-user-check fa-xs"></i></button>
                                                </form>
                                            }
                                        </td>
                                        <td><span title="@item.NgayTao.ToString("g")">@item.NgayTao.ToString("dd/MM/yyyy")</span></td>
                                        <td class="text-center action-dropdown">
                                            <div class="dropdown">
                                                <button class="btn btn-sm btn-outline-secondary border-0" type="button" id="dropdownMenuButton-@item.Id" data-bs-toggle="dropdown" aria-expanded="false" title="Thao tác khác">
                                                    <i class="fas fa-ellipsis-v fa-sm fa-fw"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end shadow animated--fade-in" aria-labelledby="dropdownMenuButton-@item.Id">
                                                    <li><a class="dropdown-item" asp-controller="AdminUser" asp-action="Details" asp-route-id="@item.Id"><i class="fas fa-eye fa-sm fa-fw me-2 text-gray-400"></i>Xem chi tiết</a></li>
                                                    @* SỬA: Bỏ class 'disabled' và cập nhật text *@
                                                    <li><a class="dropdown-item" asp-controller="AdminUser" asp-action="Edit" asp-route-id="@item.Id"><i class="fas fa-edit fa-sm fa-fw me-2 text-gray-400"></i>Sửa</a></li>
                                                    @if (item.LoaiTk != LoaiTaiKhoan.quantrivien) {
                                                        <li><hr class="dropdown-divider"></li>
                                                        if (item.TrangThaiTk == TrangThaiTaiKhoan.bidinhchi) {
                                                            <li class="dropdown-item-form">
                                                                <form asp-controller="AdminUser" asp-action="Unban" asp-route-id="@item.Id" method="post"
                                                                      onsubmit="return confirm('Kích hoạt lại người dùng [' + @Json.Serialize(item.HoTen) + ']?');">
                                                                    @Html.AntiForgeryToken()
                                                                    <input type="hidden" name="viewMode" value="table" />
                                                                    <button type="submit" class="dropdown-item text-success"><i class="fas fa-check-circle fa-sm fa-fw me-2"></i>Kích hoạt lại</button>
                                                                </form>
                                                            </li>
                                                        } else {
                                                            <li class="dropdown-item-form">
                                                                <form asp-controller="AdminUser" asp-action="Ban" asp-route-id="@item.Id" method="post"
                                                                      onsubmit="return confirm('Cấm người dùng [' + @Json.Serialize(item.HoTen) + ']?');">
                                                                    @Html.AntiForgeryToken()
                                                                    <input type="hidden" name="viewMode" value="table" />
                                                                    <button type="submit" class="dropdown-item text-danger"><i class="fas fa-ban fa-sm fa-fw me-2"></i>Cấm tài khoản</button>
                                                                </form>
                                                            </li>
                                                        }
                                                        <li><hr class="dropdown-divider"></li>
                                                        <li>
                                                             @* XÓA: Bỏ class 'disabled' và cập nhật text *@
                                                             <a class="dropdown-item text-danger" asp-controller="AdminUser" asp-action="Delete" asp-route-id="@item.Id" asp-route-viewMode="table">
                                                                 <i class="fas fa-trash-alt fa-sm fa-fw me-2"></i>Xóa
                                                             </a>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else {
                                <tr>
                                    <td colspan="7" class="text-center py-5"> @* Cập nhật colspan nếu đổi cột *@
                                         <div class="text-center py-5 text-muted">
                                             <i class="fas fa-users-slash fa-3x mb-3"></i><br>
                                             Không tìm thấy người dùng nào phù hợp với bộ lọc hiện tại.
                                         </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div><!-- /.table-responsive -->
            </div><!-- /.card-body table -->
         }

        <!-- Phân trang -->
         @if (hasUsers && totalPages > 1)
        {
            <div class="card-footer bg-light py-2 px-3 d-flex flex-column flex-sm-row justify-content-between align-items-center">
                 <div class="text-muted small mb-2 mb-sm-0">
                     Hiển thị @startIndex - @endIndex trên tổng số @totalUsers người dùng
                 </div>
                 <nav aria-label="Page navigation">
                     <ul class="pagination pagination-sm mb-0">
                        @{
                            Func<int, Dictionary<string, string>> getPageRouteData = (pageNum) => {
                                var routeData = new Dictionary<string, string>(finalRouteData);
                                routeData["pageNumber"] = pageNum.ToString();
                                return routeData;
                            };
                            var firstPageRouteData = getPageRouteData(1);
                            var prevPageRouteData = getPageRouteData(pageNumber - 1);
                            var nextPageRouteData = getPageRouteData(pageNumber + 1);
                            var lastPageRouteData = getPageRouteData(totalPages);
                        }
                         <li class="page-item @(pageNumber <= 1 ? "disabled" : "")">
                             <a class="page-link" asp-controller="AdminUser" asp-action="Index" asp-all-route-data="firstPageRouteData" aria-label="Trang đầu"><span aria-hidden="true">««</span></a>
                         </li>
                         <li class="page-item @(pageNumber <= 1 ? "disabled" : "")">
                             <a class="page-link" asp-controller="AdminUser" asp-action="Index" asp-all-route-data="prevPageRouteData" aria-label="Trang trước"><span aria-hidden="true">«</span></a>
                         </li>
                        @{
                            int range = 2;
                            int startPage = Math.Max(1, pageNumber - range);
                            int endPage = Math.Min(totalPages, pageNumber + range);
                            if (totalPages > (range * 2)) {
                                if (startPage == 1) endPage = Math.Min(totalPages, startPage + (range * 2));
                                if (endPage == totalPages) startPage = Math.Max(1, endPage - (range * 2));
                            }
                            if (startPage > 1) {
                                <li class="page-item"><a class="page-link" asp-controller="AdminUser" asp-action="Index" asp-all-route-data="getPageRouteData(1)">1</a></li>
                                if (startPage > 2) { <li class="page-item disabled"><span class="page-link">...</span></li> }
                            }
                            for (int i = startPage; i <= endPage; i++) {
                                <li class="page-item @(i == pageNumber ? "active" : "")" @(i == pageNumber ? "aria-current='page'" : "")>
                                    @if(i == pageNumber) { <span class="page-link">@i</span> } else { <a class="page-link" asp-controller="AdminUser" asp-action="Index" asp-all-route-data="getPageRouteData(i)">@i</a> }
                                </li>
                            }
                            if (endPage < totalPages) {
                                if (endPage < totalPages - 1) { <li class="page-item disabled"><span class="page-link">...</span></li> }
                                <li class="page-item"><a class="page-link" asp-controller="AdminUser" asp-action="Index" asp-all-route-data="lastPageRouteData">@totalPages</a></li>
                            }
                        }
                         <li class="page-item @(pageNumber >= totalPages ? "disabled" : "")">
                             <a class="page-link" asp-controller="AdminUser" asp-action="Index" asp-all-route-data="nextPageRouteData" aria-label="Trang sau"><span aria-hidden="true">»</span></a>
                         </li>
                         <li class="page-item @(pageNumber >= totalPages ? "disabled" : "")">
                              <a class="page-link" asp-controller="AdminUser" asp-action="Index" asp-all-route-data="lastPageRouteData" aria-label="Trang cuối"><span aria-hidden="true">»»</span></a>
                         </li>
                     </ul>
                 </nav>
            </div>
        }
         else if (hasUsers) {
             <div class="card-footer bg-light py-2 px-3">
                  <div class="text-muted small">Hiển thị @totalUsers người dùng</div>
             </div>
         }

    </div> <!-- /.card -->
</div> <!-- /.container-fluid -->

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
         // Kích hoạt tooltip của Bootstrap
         if (typeof bootstrap !== 'undefined' && bootstrap.Tooltip) {
             var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"], [title]:not(iframe)'))
             var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                var existingTooltip = bootstrap.Tooltip.getInstance(tooltipTriggerEl);
                if (!existingTooltip) {
                     return new bootstrap.Tooltip(tooltipTriggerEl);
                }
                return existingTooltip;
             });
         } else {
             console.warn("Bootstrap Tooltip component not found. Make sure Bootstrap JS is loaded.");
         }
    });
</script>
}