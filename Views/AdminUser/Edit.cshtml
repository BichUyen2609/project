
@* File: Views/AdminUser/Edit.cshtml *@
@model HeThongTimViec.ViewModels.Admin.AdminUserEditViewModel
@using HeThongTimViec.Models 
@using HeThongTimViec.Controllers 

@{
    ViewData["Title"] = $"Chỉnh sửa: {Model.HoTen}";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml"; // Đảm bảo đường dẫn layout đúng

    // Lấy thông tin trạng thái và vai trò từ ViewBag (được set trong Controller GET)
    var currentStatusText = ViewBag.CurrentStatusText ?? "Không xác định";
    var currentStatusBadge = ViewBag.CurrentStatusBadge ?? "badge bg-light text-dark";
    var currentRoleText = ViewBag.CurrentRoleText ?? "Không xác định";
    var isBusinessVerified = ViewBag.IsBusinessVerified as bool?; // Lấy trạng thái xác minh DN

    // Tạo chữ cái đầu cho avatar (giống Details)
    var initials = "?";
    if (!string.IsNullOrWhiteSpace(Model.HoTen))
    {
        var nameParts = Model.HoTen.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        initials = nameParts.Length > 0 ? nameParts[^1][0].ToString().ToUpper() : "?";
    }
}

<style>
    /* Thiết kế mới cho trang Edit */
    .avatar-circle {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #4e73df;
        color: white;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        transition: all 0.2s ease;
    }
    
    .avatar-circle:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.15);
    }
    
    .initials {
        font-size: 16px;
        font-weight: bold;
    }
    
    .section-header {
        padding-bottom: 10px;
        border-bottom: 1px solid rgba(0,0,0,0.08);
        color: #4e73df;
        margin-bottom: 1.25rem;
    }
    
    .bg-gradient-light {
        background: linear-gradient(to right, #f8f9fc, #ffffff);
    }
    
    /* Card styling */
    .card {
        border: none;
        transition: all 0.3s;
        box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.1);
    }
    
    .card:hover {
        box-shadow: 0 0.15rem 1.75rem 0 rgba(58, 59, 69, 0.15);
    }
    
    .card-header {
        background-color: #f8f9fc;
        border-bottom: 1px solid #e3e6f0;
    }
    
    /* Form controls */
    .form-control, .form-select {
        border-radius: 0.35rem;
        padding: 0.375rem 0.75rem;
        border: 1px solid #d1d3e2;
        transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
    }
    
    .form-control:focus, .form-select:focus {
        border-color: #bac8f3;
        box-shadow: 0 0 0 0.25rem rgba(78, 115, 223, 0.1);
    }
    
    /* Floating labels styling */
    .form-floating > .form-control,
    .form-floating > .form-select {
        height: calc(3.25rem + 2px);
        padding: 1.25rem 0.75rem 0.25rem 0.75rem;
    }
    
    .form-floating > label {
        padding: 0.75rem 0.75rem;
        opacity: 0.65;
    }
    
    .form-floating > .form-control:focus ~ label,
    .form-floating > .form-control:not(:placeholder-shown) ~ label,
    .form-floating > .form-select ~ label {
        opacity: 0.65;
        transform: scale(0.85) translateY(-0.5rem) translateX(0.15rem);
    }
    
    /* Buttons styling */
    .btn-primary {
        background-color: #4e73df;
        border-color: #4e73df;
        transition: all 0.2s;
    }
    
    .btn-primary:hover {
        background-color: #4262c5;
        border-color: #3d5cb9;
    }
    
    .btn-outline-secondary {
        color: #6c757d;
        border-color: #6c757d;
    }
    
    .btn-outline-secondary:hover {
        background-color: #6c757d;
        color: #fff;
    }
    
    /* Required field */
    .required-field::after {
        content: " *";
        color: #e74a3b;
        font-weight: bold;
    }
    
    /* Card footer */
    .card-footer {
        border-top: 1px solid #e3e6f0;
        background-color: #f8f9fc;
    }
    
    /* Custom breadcrumb */
    .breadcrumb {
        background-color: #f8f9fc;
        border-radius: 0.35rem;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.05);
        border: 1px solid #e3e6f0;
    }
    
    .breadcrumb-item a {
        color: #4e73df;
        text-decoration: none;
        transition: color 0.2s;
    }
    
    .breadcrumb-item a:hover {
        color: #2e59d9;
        text-decoration: underline;
    }
    
    /* Animation for loading */
    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
    
    .fa-spinner {
        animation: spin 1s linear infinite;
    }
    
    /* Alert styling */
    .alert {
        border-radius: 0.35rem;
    }
    
    /* Responsive adjustments */
    @@media (max-width: 767.98px) {
        .col-form-label {
            margin-bottom: 0.5rem;
        }
    }
    
    /* Tooltip styling */
    .info-tooltip {
        color: #4e73df;
        cursor: pointer;
    }
    
    /* Custom shadow for form groups */
    .form-group-shadowed {
        transition: all 0.3s;
    }
    
    .form-group-shadowed:focus-within {
        transform: translateY(-2px);
    }
</style>

<div class="container-fluid px-4">
    
    <div class="d-flex justify-content-between align-items-center py-3 mb-4">
        <h4 class="m-0 text-primary">
            <i class="fas fa-user-edit me-2"></i>@ViewData["Title"]
        </h4>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i><span class="ms-2">Quay lại chi tiết</span>
        </a>
    </div>

    <!-- Nội dung Chính -->
    <div class="card shadow rounded-3 mb-4">
        <div class="card-header py-3 d-flex align-items-center">
            <div class="me-auto d-flex align-items-center">
                <div class="avatar-circle me-3">
                    <span class="initials">@initials</span>
                </div>
                <div>
                    <h5 class="fw-bold mb-0">@Model.HoTen</h5>
                    <span class="text-muted small">@Model.Email</span>
                </div>
            </div>
            <span class="badge @currentStatusBadge text-uppercase me-2 px-3 py-2">@currentStatusText</span>
            <span class="badge bg-info text-dark text-uppercase px-3 py-2">@currentRoleText</span>
        </div>

        <div class="card-body p-4">
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        <span>Vui lòng kiểm tra lại các thông tin đã nhập.</span>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="needs-validation" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <!-- Loại tài khoản không được sửa, chỉ dùng để hiển thị đúng trường -->
                <input type="hidden" asp-for="LoaiTk" />

                <div class="row g-4">
                    <!-- Cột Trái: Thông tin chính -->
                    <div class="col-lg-8">
                        <!-- Thông tin cá nhân/cơ bản -->
                        <div class="mb-4">
                            <div class="section-header d-flex align-items-center">
                                <i class="fas fa-user-circle fa-fw me-2"></i>
                                <h5 class="m-0 fw-bold">Thông tin Cơ bản</h5>
                            </div>
                            
                            <div class="row g-3 mt-3">
                                <div class="col-md-6">
                                    <div class="form-floating form-group-shadowed mb-3">
                                        <input asp-for="HoTen" class="form-control" placeholder="Nhập họ tên" required />
                                        <label asp-for="HoTen" class="required-field">Họ và tên</label>
                                        <span asp-validation-for="HoTen" class="text-danger small d-block mt-1"></span>
                                    </div>
                                </div>
                                
                                <div class="col-md-6">
                                    <div class="form-floating form-group-shadowed mb-3">
                                        <input asp-for="Email" class="form-control" placeholder="Nhập email" required />
                                        <label asp-for="Email" class="required-field">Email</label>
                                        <span asp-validation-for="Email" class="text-danger small d-block mt-1"></span>
                                    </div>
                                </div>
                                
                                <div class="col-md-6">
                                    <div class="form-floating form-group-shadowed mb-3">
                                        <input asp-for="Sdt" class="form-control" placeholder="Nhập số điện thoại" />
                                        <label asp-for="Sdt">Số điện thoại</label>
                                        <span asp-validation-for="Sdt" class="text-danger small d-block mt-1"></span>
                                    </div>
                                </div>
                                
                                <div class="col-md-6">
                                    <div class="row g-3">
                                        <div class="col-sm-7">
                                            <div class="form-floating form-group-shadowed mb-3">
                                                <input asp-for="NgaySinh" type="date" class="form-control" placeholder="Ngày sinh" max="@DateTime.Today.ToString("yyyy-MM-dd")"/>
                                                <label asp-for="NgaySinh">Ngày sinh</label>
                                                <span asp-validation-for="NgaySinh" class="text-danger small d-block mt-1"></span>
                                            </div>
                                        </div>
                                        
                                        <div class="col-sm-5">
                                            <div class="form-floating form-group-shadowed mb-3">
                                                <select asp-for="GioiTinh" class="form-select" asp-items="Html.GetEnumSelectList<GioiTinhNguoiDung>()">
                                                    <option value="">--Chọn--</option>
                                                </select>
                                                <label asp-for="GioiTinh">Giới tính</label>
                                                <span asp-validation-for="GioiTinh" class="text-danger small d-block mt-1"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Thông tin địa chỉ -->
                        <div class="mb-4">
                            <div class="section-header d-flex align-items-center">
                                <i class="fas fa-map-marker-alt fa-fw me-2"></i>
                                <h5 class="m-0 fw-bold">Địa chỉ</h5>
                            </div>
                            
                            <div class="row g-3 mt-3">
                                <div class="col-md-6">
                                    <div class="form-floating form-group-shadowed mb-3">
                                        <select asp-for="ThanhPhoId" id="ThanhPhoId" class="form-select" asp-items="ViewBag.ThanhPhoId">
                                            <option value="">--Chọn Tỉnh/Thành phố--</option>
                                        </select>
                                        <label asp-for="ThanhPhoId">Tỉnh/Thành phố</label>
                                        <span asp-validation-for="ThanhPhoId" class="text-danger small d-block mt-1"></span>
                                    </div>
                                </div>
                                
                                <div class="col-md-6">
                                    <div class="form-floating form-group-shadowed mb-3">
                                        <select asp-for="QuanHuyenId" id="QuanHuyenId" class="form-select" asp-items="ViewBag.QuanHuyenId" disabled>
                                            <option value="">--Chọn Tỉnh/TP trước--</option>
                                        </select>
                                        <label asp-for="QuanHuyenId">Quận/Huyện</label>
                                        <span asp-validation-for="QuanHuyenId" class="text-danger small d-block mt-1"></span>
                                        <div id="district-loading" class="text-muted small mt-1" style="display: none;">
                                            <i class="fas fa-spinner fa-spin"></i> Đang tải...
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="col-12">
                                    <div class="form-floating form-group-shadowed mb-3">
                                        <input asp-for="DiaChiChiTiet" class="form-control" placeholder="Nhập địa chỉ chi tiết" />
                                        <label asp-for="DiaChiChiTiet">Địa chỉ chi tiết (Số nhà, đường)</label>
                                        <span asp-validation-for="DiaChiChiTiet" class="text-danger small d-block mt-1"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Thông tin Hồ sơ Doanh nghiệp (CHỈ HIỂN THỊ NẾU LÀ DOANH NGHIỆP) -->
                        @if (Model.LoaiTk == LoaiTaiKhoan.doanhnghiep)
                        {
                            <div class="mb-4">
                                <div class="section-header d-flex align-items-center">
                                    <i class="fas fa-building fa-fw me-2"></i>
                                    <h5 class="m-0 fw-bold">Thông tin Công ty</h5>
                                </div>
                                
                                <div class="row g-3 mt-3">
                                    <div class="col-md-6">
                                        <div class="form-floating form-group-shadowed mb-3">
                                            <input asp-for="TenCongTy" class="form-control" placeholder="Nhập tên công ty" required />
                                            <label asp-for="TenCongTy" class="required-field">Tên công ty</label>
                                            <span asp-validation-for="TenCongTy" class="text-danger small d-block mt-1"></span>
                                        </div>
                                    </div>
                                    
                                    <div class="col-md-6">
                                        <div class="form-floating form-group-shadowed mb-3">
                                            <input asp-for="MaSoThue" class="form-control" placeholder="Nhập mã số thuế" />
                                            <label asp-for="MaSoThue">Mã số thuế</label>
                                            <span asp-validation-for="MaSoThue" class="text-danger small d-block mt-1"></span>
                                        </div>
                                    </div>
                                    
                                    <div class="col-md-6">
                                        <div class="form-floating form-group-shadowed mb-3">
                                            <input asp-for="UrlWebsite" type="url" class="form-control" placeholder="https://example.com" />
                                            <label asp-for="UrlWebsite">Website</label>
                                            <span asp-validation-for="UrlWebsite" class="text-danger small d-block mt-1"></span>
                                        </div>
                                    </div>
                                    
                                    <div class="col-md-6">
                                        <div class="form-floating form-group-shadowed mb-3">
                                            <input asp-for="QuyMoCongTy" class="form-control" placeholder="VD: 10-50 nhân viên" />
                                            <label asp-for="QuyMoCongTy">Quy mô công ty</label>
                                            <span asp-validation-for="QuyMoCongTy" class="text-danger small d-block mt-1"></span>
                                        </div>
                                    </div>
                                    
                                    <div class="col-12">
                                        <div class="form-floating form-group-shadowed mb-3">
                                            <input asp-for="DiaChiDangKy" class="form-control" placeholder="Nhập địa chỉ ĐKKD" />
                                            <label asp-for="DiaChiDangKy">Địa chỉ Đăng ký Kinh doanh</label>
                                            <span asp-validation-for="DiaChiDangKy" class="text-danger small d-block mt-1"></span>
                                        </div>
                                    </div>
                                    
                                    <div class="col-12">
                                        <div class="form-floating form-group-shadowed mb-3">
                                            <textarea asp-for="MoTaCongTy" class="form-control" placeholder="Giới thiệu về công ty" style="height: 120px"></textarea>
                                            <label asp-for="MoTaCongTy">Mô tả công ty</label>
                                            <span asp-validation-for="MoTaCongTy" class="text-danger small d-block mt-1"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        } @* Kết thúc if Doanh nghiệp *@
                    </div>

                    <!-- Cột Phải: Thông tin tài khoản (Read-only) -->
                    <div class="col-lg-4">
                        <div class="card border h-100">
                            <div class="card-header py-3">
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-shield-alt text-primary me-2"></i>
                                    <h5 class="m-0 fw-bold">Thông tin Tài khoản</h5>
                                </div>
                            </div>
                            
                            <div class="card-body d-flex flex-column">
                                <div class="mb-3 flex-grow-1">
                                    <div class="mb-4">
                                        <span class="text-muted small d-block mb-2">Loại tài khoản:</span>
                                        <div class="d-flex align-items-center">
                                            <i class="fas fa-user-tag text-primary me-2 fa-fw"></i>
                                            <strong>@currentRoleText</strong>
                                        </div>
                                    </div>

                                    <div class="mb-4">
                                        <span class="text-muted small d-block mb-2">Trạng thái hiện tại:</span>
                                        <div class="d-flex align-items-center">
                                            <i class="fas fa-toggle-on text-primary me-2 fa-fw"></i>
                                            <span class="@currentStatusBadge py-1 px-2">@currentStatusText</span>
                                        </div>
                                        <small class="text-muted fst-italic d-block mt-2">
                                            <i class="fas fa-info-circle me-1"></i> Quản lý trạng thái qua nút Cấm / Bỏ cấm / Xác minh tại trang chi tiết.
                                        </small>
                                    </div>

                                    @if(Model.LoaiTk == LoaiTaiKhoan.doanhnghiep)
                                    {
                                        <div class="mb-4">
                                            <span class="text-muted small d-block mb-2">Trạng thái xác minh:</span>
                                            <div class="d-flex align-items-center">
                                                @if (isBusinessVerified == true)
                                                {
                                                    <i class="fas fa-check-circle text-success me-2 fa-fw"></i>
                                                    <strong class="text-success">Đã xác minh</strong>
                                                }
                                                else
                                                {
                                                    <i class="fas fa-times-circle text-warning me-2 fa-fw"></i>
                                                    <strong class="text-warning">Chưa xác minh</strong>
                                                }
                                            </div>
                                            <small class="text-muted fst-italic d-block mt-2">
                                                <i class="fas fa-info-circle me-1"></i> Quản lý xác minh tại trang chi tiết.
                                            </small>
                                        </div>
                                    }
                                </div>
                                
                                <div class="alert alert-info p-3 mb-0 mt-auto">
                                    <div class="d-flex">
                                        <i class="fas fa-info-circle mt-1 me-2"></i>
                                        <div>
                                            <strong>Lưu ý:</strong> Các thông tin tài khoản như Loại TK, Trạng thái, Xác minh không thể thay đổi trực tiếp tại đây. Vui lòng sử dụng các chức năng tại trang chi tiết.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Nút Hành động -->
                <div class="d-flex justify-content-end gap-3 mt-4 pt-3 border-top">
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                        <i class="fas fa-times me-2"></i> Hủy thay đổi
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-save me-2"></i> Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function () {
            // --- Bootstrap Form Validation ---
            (() => {
                'use strict'
                const forms = document.querySelectorAll('.needs-validation')
                Array.from(forms).forEach(form => {
                    form.addEventListener('submit', event => {
                        if (!form.checkValidity()) {
                            event.preventDefault()
                            event.stopPropagation()
                        }
                        form.classList.add('was-validated')
                    }, false)
                })
            })()

            // --- District Loading Logic ---
            var districtSelect = $('#QuanHuyenId');
            var districtLoading = $('#district-loading');
            var citySelect = $('#ThanhPhoId');

            function loadDistricts(cityId, selectedDistrictId) {
                districtSelect.empty().prop('disabled', true); // Clear and disable
                if (!cityId) {
                    districtSelect.append($('<option>', { value: '', text: '--Chọn Tỉnh/TP trước--' }));
                    return;
                }

                districtLoading.show();
                districtSelect.append($('<option>', { value: '', text: 'Đang tải...' }));

                $.ajax({
                    url: `/api/DiaChi/GetQuanHuyenByThanhPho/${cityId}`, // Use template literal for clarity
                    type: 'GET',
                    dataType: 'json', // Expect JSON response
                    success: function (data) {
                        districtSelect.empty(); // Clear loading message
                        districtSelect.append($('<option>', { value: '', text: '--Chọn Quận/Huyện--' }));
                        if (data && data.length > 0) {
                            $.each(data, function (index, item) {
                                districtSelect.append($('<option>', {
                                    value: item.id,
                                    text: item.ten
                                }));
                            });
                            // If a district was previously selected (on page load or validation fail), select it
                            if (selectedDistrictId) {
                                districtSelect.val(selectedDistrictId);
                            }
                            districtSelect.prop('disabled', false); // Enable after loading
                        } else {
                            // No districts found, keep disabled or show message
                            districtSelect.append($('<option>', { value: '', text: '--Không có Quận/Huyện--' })).prop('disabled', true);
                            console.warn("Không tìm thấy quận/huyện cho thành phố ID: " + cityId);
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error("Lỗi khi tải quận/huyện:", status, error, xhr.responseText);
                        districtSelect.empty(); // Clear loading on error
                        districtSelect.append($('<option>', { value: '', text: '--Lỗi tải dữ liệu--' })).prop('disabled', true);
                    },
                    complete: function () {
                        districtLoading.hide(); // Hide loading indicator regardless of outcome
                    }
                });
            }

            // Event handler for City change
            citySelect.change(function () {
                var selectedCityId = $(this).val();
                loadDistricts(selectedCityId, null); // Load new districts, null indicates no pre-selection needed
            });

            // Initial Load Logic for Edit Page
            var initialCityId = citySelect.val();
            // Use @Html.Raw(Json.Serialize(Model.QuanHuyenId)) to safely pass the C# value to JS
            var initialDistrictId = @Html.Raw(Json.Serialize(Model.QuanHuyenId ?? 0)); // Use 0 or null if null

            if (initialCityId) {
                // Load districts for the initially selected city and try to select the initial district
                loadDistricts(initialCityId, initialDistrictId);
            } else {
                // Keep district dropdown disabled if no city is initially selected
                 districtSelect.prop('disabled', true);
                 districtSelect.empty().append($('<option>', { value: '', text: '--Chọn Tỉnh/TP trước--' }));
            }
        });
    </script>
}
