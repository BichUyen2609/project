@model HeThongTimViec.ViewModels.TimViec.TimViecSearchViewModel
@using HeThongTimViec.Models
@using System.Globalization
@using System.Linq

@{
    ViewData["Title"] = "Tìm Việc Làm Bán Thời Gian & Thời Vụ";
    var totalPages = Model.PageSize > 0 && Model.TotalCount > 0 ? (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize) : 1;
    var hasPreviousPage = Model.PageIndex > 1;
    var hasNextPage = Model.PageIndex < totalPages;

    // Helper function moved to @functions block at the bottom
}

<div class="container mt-4 mb-5">
    <div class="row">
        <!-- ============================ -->
        <!--       CỘT BỘ LỌC (TRÁI)     -->
        <!-- ============================ -->
        <div class="col-lg-3 mb-4">
            <form asp-action="Index" method="get" id="filter-form">
                <input type="hidden" asp-for="SortOrder" />
                <input type="hidden" asp-for="PageSize" />

                <div class="card shadow-sm mb-3 sticky-lg-top" style="top: 20px;">
                    <div class="card-header d-flex justify-content-between align-items-center bg-light">
                        <h5 class="mb-0"><i class="fas fa-filter me-2 text-primary"></i>Bộ lọc tìm kiếm</h5>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="reset-filter-btn" title="Xóa bộ lọc">
                            <i class="fas fa-undo"></i> Đặt lại
                        </button>
                    </div>
                    <div class="card-body p-3">
                        <!-- Từ khóa -->
                        <div class="mb-3">
                            <label asp-for="TuKhoa" class="form-label fw-semibold small"></label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text"><i class="fas fa-search"></i></span>
                                <input asp-for="TuKhoa" class="form-control" placeholder="Chức danh, công ty, kỹ năng..." />
                            </div>
                        </div>

                        <!-- Bộ lọc Accordion -->
                        <div class="accordion accordion-flush" id="filterAccordion">

                            @* --- Loại công việc (Viết HTML trực tiếp) --- *@
                            <div class="accordion-item border-bottom">
                                <h2 class="accordion-header" id="heading-loaicongviec">
                                    <button class="accordion-button @(Model.SelectedLoaiCongViec.HasValue ? "" : "collapsed") fw-semibold py-2 px-0" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-loaicongviec" aria-expanded="@(Model.SelectedLoaiCongViec.HasValue.ToString().ToLower())" aria-controls="collapse-loaicongviec">
                                        <i class="fa-solid fa-briefcase fa-fw me-2 text-muted"></i>Loại công việc
                                    </button>
                                </h2>
                                <div id="collapse-loaicongviec" class="accordion-collapse collapse @(Model.SelectedLoaiCongViec.HasValue ? "show" : "")" aria-labelledby="heading-loaicongviec">
                                    <div class="accordion-body pt-1 pb-3 px-0">
                                        <select asp-for="SelectedLoaiCongViec" asp-items="Model.LoaiCongViecList" class="form-select form-select-sm">
                                            <option value="">-- Tất cả loại công việc --</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                             @* --- Địa điểm (Viết HTML trực tiếp) --- *@
                            <div class="accordion-item border-bottom">
                                <h2 class="accordion-header" id="heading-diadiem">
                                    <button class="accordion-button @(Model.SelectedThanhPhoId.HasValue || Model.SelectedQuanHuyenId.HasValue ? "" : "collapsed") fw-semibold py-2 px-0" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-diadiem" aria-expanded="@((Model.SelectedThanhPhoId.HasValue || Model.SelectedQuanHuyenId.HasValue).ToString().ToLower())" aria-controls="collapse-diadiem">
                                        <i class="fa-solid fa-location-dot fa-fw me-2 text-muted"></i>Địa điểm
                                    </button>
                                </h2>
                                <div id="collapse-diadiem" class="accordion-collapse collapse @(Model.SelectedThanhPhoId.HasValue || Model.SelectedQuanHuyenId.HasValue ? "show" : "")" aria-labelledby="heading-diadiem">
                                    <div class="accordion-body pt-1 pb-3 px-0">
                                        <div class="mb-2">
                                            <select asp-for="SelectedThanhPhoId" asp-items="Model.ThanhPhoList" class="form-select form-select-sm" id="thanhPhoFilter">
                                                <option value="">-- Chọn Tỉnh/Thành phố --</option>
                                            </select>
                                        </div>
                                        <div>
                                            <select asp-for="SelectedQuanHuyenId" asp-items="Model.QuanHuyenList" class="form-select form-select-sm" id="quanHuyenFilter" disabled>
                                                <option value="">-- Chọn Quận/Huyện --</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @* --- Ngành nghề (Viết HTML trực tiếp) --- *@
                             <div class="accordion-item border-bottom">
                                <h2 class="accordion-header" id="heading-nganhnghe">
                                    <button class="accordion-button @(Model.SelectedNganhNgheIds?.Any() ?? false ? "" : "collapsed") fw-semibold py-2 px-0" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-nganhnghe" aria-expanded="@((Model.SelectedNganhNgheIds?.Any() ?? false).ToString().ToLower())" aria-controls="collapse-nganhnghe">
                                        <i class="fa-solid fa-tags fa-fw me-2 text-muted"></i>Ngành nghề
                                    </button>
                                </h2>
                                <div id="collapse-nganhnghe" class="accordion-collapse collapse @(Model.SelectedNganhNgheIds?.Any() ?? false ? "show" : "")" aria-labelledby="heading-nganhnghe">
                                    <div class="accordion-body pt-1 pb-3 px-0">
                                         <div class="filter-scrollable-list" style="max-height: 200px; overflow-y: auto;">
                                             @if(Model.NganhNgheList != null && Model.NganhNgheList.Any()) {
                                                 @foreach (var item in Model.NganhNgheList) {
                                                    <div class="form-check">
                                                         <input class="form-check-input" type="checkbox" name="SelectedNganhNgheIds" value="@item.Value" id="nn-@item.Value" checked="@item.Selected"> @* Dùng checked *@
                                                         <label class="form-check-label small" for="nn-@item.Value">
                                                             @item.Text
                                                         </label>
                                                    </div>
                                                 }
                                             } else {
                                                 <small class="text-muted">Không có dữ liệu ngành nghề.</small>
                                             }
                                         </div>
                                    </div>
                                </div>
                            </div>

                             @* --- Ca làm việc (Viết HTML trực tiếp) --- *@
                             <div class="accordion-item border-bottom">
                                <h2 class="accordion-header" id="heading-calamviec">
                                    <button class="accordion-button @(Model.SelectedNgayTrongTuan.HasValue || Model.SelectedBuoi.HasValue ? "" : "collapsed") fw-semibold py-2 px-0" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-calamviec" aria-expanded="@((Model.SelectedNgayTrongTuan.HasValue || Model.SelectedBuoi.HasValue).ToString().ToLower())" aria-controls="collapse-calamviec">
                                        <i class="fa-regular fa-calendar-alt fa-fw me-2 text-muted"></i>Ca làm việc
                                    </button>
                                </h2>
                                <div id="collapse-calamviec" class="accordion-collapse collapse @(Model.SelectedNgayTrongTuan.HasValue || Model.SelectedBuoi.HasValue ? "show" : "")" aria-labelledby="heading-calamviec">
                                    <div class="accordion-body pt-1 pb-3 px-0">
                                        <div class="mb-2">
                                            <label class="form-label small fw-medium">Ngày trong tuần:</label>
                                            <select asp-for="SelectedNgayTrongTuan" asp-items="Model.NgayTrongTuanList" class="form-select form-select-sm">
                                                <option value="">-- Tất cả các ngày --</option>
                                            </select>
                                         </div>
                                         <div>
                                             <label class="form-label small fw-medium">Buổi làm việc:</label>
                                             <select asp-for="SelectedBuoi" asp-items="Model.BuoiLamViecList" class="form-select form-select-sm">
                                                 <option value="">-- Tất cả các buổi --</option>
                                             </select>
                                         </div>
                                    </div>
                                </div>
                            </div>

                            @* --- Kinh nghiệm (Viết HTML trực tiếp) --- *@
                            <div class="accordion-item border-bottom">
                                <h2 class="accordion-header" id="heading-kinhnghiem">
                                     <button class="accordion-button @(!string.IsNullOrEmpty(Model.SelectedKinhNghiem) ? "" : "collapsed") fw-semibold py-2 px-0" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-kinhnghiem" aria-expanded="@((!string.IsNullOrEmpty(Model.SelectedKinhNghiem)).ToString().ToLower())" aria-controls="collapse-kinhnghiem">
                                         <i class="fa-solid fa-award fa-fw me-2 text-muted"></i>Kinh nghiệm
                                     </button>
                                </h2>
                                <div id="collapse-kinhnghiem" class="accordion-collapse collapse @(!string.IsNullOrEmpty(Model.SelectedKinhNghiem) ? "show" : "")" aria-labelledby="heading-kinhnghiem">
                                     <div class="accordion-body pt-1 pb-3 px-0">
                                        <input asp-for="SelectedKinhNghiem" class="form-control form-control-sm" placeholder="VD: Không yêu cầu, 6 tháng..." />
                                     </div>
                                </div>
                            </div>

                            @* --- Mức lương (Viết HTML trực tiếp) --- *@
                            <div class="accordion-item border-bottom">
                                <h2 class="accordion-header" id="heading-mucluong">
                                     <button class="accordion-button @(Model.SelectedLoaiLuong.HasValue || Model.MucLuongMin.HasValue ? "" : "collapsed") fw-semibold py-2 px-0" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-mucluong" aria-expanded="@((Model.SelectedLoaiLuong.HasValue || Model.MucLuongMin.HasValue).ToString().ToLower())" aria-controls="collapse-mucluong">
                                         <i class="fa-solid fa-dollar-sign fa-fw me-2 text-muted"></i>Mức lương
                                     </button>
                                </h2>
                                <div id="collapse-mucluong" class="accordion-collapse collapse @(Model.SelectedLoaiLuong.HasValue || Model.MucLuongMin.HasValue ? "show" : "")" aria-labelledby="heading-mucluong">
                                     <div class="accordion-body pt-1 pb-3 px-0">
                                        <div class="mb-2">
                                            <label asp-for="SelectedLoaiLuong" class="form-label small fw-medium">Loại lương:</label>
                                             <select asp-for="SelectedLoaiLuong" asp-items="Model.LoaiLuongList" class="form-select form-select-sm">
                                                 <option value="">-- Tất cả loại lương --</option>
                                             </select>
                                         </div>
                                        <label class="form-label small fw-medium">Mức lương tối thiểu (nghìn đồng):</label>
                                        <div class="input-group input-group-sm mb-2">
                                             <input asp-for="MucLuongMin" type="number" min="0" class="form-control" placeholder="VD: 30" />
                                              <span class="input-group-text">.000</span>
                                        </div>
                                     </div>
                                </div>
                            </div>

                             @* --- Kỹ năng (Viết HTML trực tiếp) --- *@
                             <div class="accordion-item border-bottom">
                                <h2 class="accordion-header" id="heading-kynang">
                                     <button class="accordion-button @(!string.IsNullOrEmpty(Model.KyNang) ? "" : "collapsed") fw-semibold py-2 px-0" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-kynang" aria-expanded="@((!string.IsNullOrEmpty(Model.KyNang)).ToString().ToLower())" aria-controls="collapse-kynang">
                                         <i class="fa-solid fa-cogs fa-fw me-2 text-muted"></i>Kỹ năng
                                     </button>
                                </h2>
                                <div id="collapse-kynang" class="accordion-collapse collapse @(!string.IsNullOrEmpty(Model.KyNang) ? "show" : "")" aria-labelledby="heading-kynang">
                                     <div class="accordion-body pt-1 pb-3 px-0">
                                         <input asp-for="KyNang" class="form-control form-control-sm" placeholder="VD: Giao tiếp, Tin học..." />
                                     </div>
                                </div>
                            </div>

                        </div> @* End Accordion *@

                        <!-- Tùy chọn khác -->
                        <hr class="my-3" />
                        <h6 class="fw-semibold mb-2">Tùy chọn hiển thị</h6>
                         <div class="form-check form-switch mb-1">
                             <input class="form-check-input" type="checkbox" role="switch" id="switchThoiVu" asp-for="ChiHienThiThoiVu">
                             <label class="form-check-label small" for="switchThoiVu">Chỉ việc làm thời vụ</label>
                         </div>
                         <div class="form-check form-switch mb-1">
                             @* FIX RZ1031: Sửa cách gán disabled *@
                             <input class="form-check-input" type="checkbox" role="switch" id="switchDaLuu" asp-for="ChiHienThiDaLuu"
                                    disabled="@(!User.Identity.IsAuthenticated)">
                             <label class="form-check-label small" for="switchDaLuu">Chỉ việc làm đã lưu</label>
                         </div>
                         <div class="form-check form-switch">
                              @* FIX RZ1031: Sửa cách gán disabled *@
                             <input class="form-check-input" type="checkbox" role="switch" id="switchDaUngTuyen" asp-for="ChiHienThiDaUngTuyen"
                                    disabled="@(!User.Identity.IsAuthenticated)">
                             <label class="form-check-label small" for="switchDaUngTuyen">Chỉ việc làm đã ứng tuyển</label>
                         </div>

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-check me-1"></i> Áp dụng bộ lọc</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>

        <!-- ============================= -->
        <!--      CỘT KẾT QUẢ (PHẢI)      -->
        <!-- ============================= -->
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2 bg-light p-2 rounded">
                <h5 class="mb-0 small">Tìm thấy <strong class="text-primary">@Model.TotalCount</strong> việc làm</h5>
                <div class="d-flex align-items-center gap-2">
                    <label for="sortOrderSelect" class="small text-nowrap mb-0">Sắp xếp:</label>
                    <select class="form-select form-select-sm" style="width: auto;" id="sortOrderSelect" name="SortOrder" asp-for="SortOrder" onchange="document.getElementById('filter-form').submit();">
                        <option value="moi_nhat" selected="@(Model.SortOrder == "moi_nhat")">Mới nhất</option> @* Thêm selected *@
                        @if (User.Identity.IsAuthenticated && Model.Results != null && Model.Results.Any()) // FIX CS8602: Thêm kiểm tra null cho Model.Results
                        {
                            <option value="phu_hop" selected="@(Model.SortOrder == "phu_hop")">Phù hợp nhất</option>
                        }
                        <option value="luong_cao" selected="@(Model.SortOrder == "luong_cao")">Lương cao đến thấp</option>
                        <option value="luong_thap" selected="@(Model.SortOrder == "luong_thap")">Lương thấp đến cao</option>
                    </select>
                    @if (User.Identity.IsAuthenticated) {
                         <a asp-controller="ViecLam" asp-action="DaLuu" asp-area="UngVien" class="btn btn-sm btn-outline-secondary text-nowrap">
                            <i class="fa-regular fa-bookmark me-1"></i> Tin đã lưu
                         </a>
                    }
                </div>
            </div>

            <!-- Danh sách việc làm -->
            <div class="row gy-3">
                @if (Model.Results != null && Model.Results.Any()) // FIX CS8602: Thêm kiểm tra null cho Model.Results
                {
                    var sortedResults = Model.SortOrder == "phu_hop" ? Model.Results.OrderByDescending(j => j.PhuHopPercent).ThenByDescending(j => j.NgayDang).ToList() : Model.Results;

                    @foreach (var job in sortedResults)
                    {
                        <div class="col-12">
                             <div class="card job-card h-100 shadow-sm border-start border-5 @(job.PhuHopPercent >= 70 ? "border-success" : job.PhuHopPercent >= 40 ? "border-warning" : "border-light")">
                                <div class="card-body p-3">
                                    <div class="row">
                                        <div class="col-sm-2 text-center d-flex flex-column align-items-center justify-content-start mb-2 mb-sm-0">
                                            @if (!string.IsNullOrEmpty(job.UrlLogoCongTy))
                                            {
                                                <img src="@job.UrlLogoCongTy" alt="Logo @(job.TenCongTy ?? "")" class="img-thumbnail rounded-circle mb-2" style="width: 60px; height: 60px; object-fit: contain;">
                                            } else {
                                                 <div class="avatar-placeholder bg-light rounded-circle border d-flex align-items-center justify-content-center mb-2" style="width: 60px; height: 60px;">
                                                      @* FIX CS8602: Thêm kiểm tra null cho job.TenCongTy *@
                                                     <i class="fas @(string.IsNullOrEmpty(job.UrlLogoCongTy) && job.TenCongTy != null && !job.TenCongTy.ToLower().Contains("công ty") ? "fa-user" : "fa-building") text-secondary fs-4"></i>
                                                 </div>
                                            }
                                            @if (User.Identity.IsAuthenticated && job.PhuHopPercent > 0)
                                            {
                                                 <div class="suitability-score" title="Độ phù hợp ước tính">
                                                     <span class="fw-bold @(job.PhuHopPercent >= 70 ? "text-success" : job.PhuHopPercent >= 40 ? "text-warning" : "text-muted")">@job.PhuHopPercent%</span>
                                                     <small class="d-block text-muted">Phù hợp</small>
                                                 </div>
                                            }
                                        </div>
                                        <div class="col-sm-7">
                                            <h5 class="card-title mb-1 fs-6">
                                                <a asp-controller="CongViec" asp-action="ChiTiet" asp-route-id="@job.Id" class="text-decoration-none stretched-link text-dark fw-semibold">@job.TieuDe</a>
                                            </h5>
                                            <p class="text-muted small mb-2">@(job.TenCongTy ?? "Nhà tuyển dụng cá nhân")</p>
                                            <div class="job-info mb-2 small d-flex flex-wrap gap-3">
                                                <span class="text-nowrap"><i class="fa-solid fa-location-dot fa-fw me-1 text-danger"></i>@job.DiaDiem</span>
                                                <span class="text-nowrap"><i class="fa-solid fa-dollar-sign fa-fw me-1 text-success"></i>@job.ThongTinLuong</span>
                                                 <span class="text-nowrap"><i class="fa-solid fa-briefcase fa-fw me-1 text-info"></i>@GetEnumDisplayName(job.LoaiHinhCongViec)</span>
                                            </div>
                                            <div class="mt-1">
                                                @foreach(var tag in job.Tags)
                                                {
                                                    <span class="badge fw-normal bg-light text-dark border me-1 mb-1">@tag</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="col-sm-3 text-sm-end d-flex flex-column justify-content-between align-items-sm-end mt-2 mt-sm-0">
                                            @if(User.Identity.IsAuthenticated) {
                                                <button type="button" class="btn btn-sm @(job.DaLuu ? "btn-danger" : "btn-outline-danger") btn-save-job mb-2" data-job-id="@job.Id" title="@(job.DaLuu ? "Bỏ lưu" : "Lưu tin")">
                                                    <i class="fa-@(job.DaLuu ? "solid" : "regular") fa-bookmark"></i> <span class="save-text d-none d-md-inline">@(job.DaLuu ? "Đã lưu" : "Lưu")</span>
                                                </button>
                                            } else {
                                                @* FIX CS1061: Sửa lại cách lấy URL *@
                                                <a asp-controller="TaiKhoan" asp-action="DangNhap" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)" class="btn btn-sm btn-outline-secondary mb-2" title="Đăng nhập để lưu tin">
                                                    <i class="fa-regular fa-bookmark"></i> <span class="d-none d-md-inline">Lưu</span>
                                                </a>
                                            }
                                             <a asp-controller="CongViec" asp-action="ChiTiet" asp-route-id="@job.Id" class="btn btn-primary btn-sm w-100 @(job.DaUngTuyen ? "disabled" : "")">
                                                 <i class="fa-solid fa-paper-plane me-1"></i> @(job.DaUngTuyen ? "Đã ứng tuyển" : "Ứng tuyển")
                                             </a>
                                            <small class="text-muted mt-2">@job.NgayDang.ToString("dd/MM/yyyy")</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center fst-italic py-5 border rounded bg-light mt-3">
                        <i class="fas fa-search fa-3x text-muted mb-3"></i>
                        <h4>Không tìm thấy việc làm phù hợp</h4>
                        <p class="text-muted">Vui lòng thử thay đổi tiêu chí tìm kiếm hoặc <a href="#" onclick="document.getElementById('reset-filter-btn').click(); return false;">xóa bộ lọc</a>.</p>
                    </div>
                }
            </div>

            <!-- Phân trang -->
            @if (totalPages > 1)
            {
                <nav aria-label="Page navigation" class="mt-4">
                    <ul class="pagination justify-content-center flex-wrap">
                         <li class="page-item @(hasPreviousPage ? "" : "disabled")">
                             <a class="page-link" asp-action="Index"
                                asp-all-route-data="@Context.Request.Query.ToDictionary(q => q.Key, q => q.Value.ToString())"
                                asp-route-PageIndex="@(Model.PageIndex - 1)"
                                aria-label="Previous">
                                 <span aria-hidden="true">«</span>
                             </a>
                         </li>
                         @{
                             int startPage = Math.Max(1, Model.PageIndex - 2);
                             int endPage = Math.Min(totalPages, Model.PageIndex + 2);
                             if (startPage > 1) {
                                 <li class="page-item"><a class="page-link" asp-action="Index" asp-all-route-data="@Context.Request.Query.ToDictionary(q => q.Key, q => q.Value.ToString())" asp-route-PageIndex="1">1</a></li>
                                 if (startPage > 2) { <li class="page-item disabled"><span class="page-link">...</span></li> }
                             }
                             for (var i = startPage; i <= endPage; i++) {
                                 <li class="page-item @(i == Model.PageIndex ? "active" : "")" aria-current="@(i == Model.PageIndex ? "page" : null)">
                                     <a class="page-link" asp-action="Index" asp-all-route-data="@Context.Request.Query.ToDictionary(q => q.Key, q => q.Value.ToString())" asp-route-PageIndex="@i">@i</a>
                                 </li>
                             }
                              if (endPage < totalPages) {
                                 if (endPage < totalPages - 1) { <li class="page-item disabled"><span class="page-link">...</span></li> }
                                 <li class="page-item"><a class="page-link" asp-action="Index" asp-all-route-data="@Context.Request.Query.ToDictionary(q => q.Key, q => q.Value.ToString())" asp-route-PageIndex="@totalPages">@totalPages</a></li>
                             }
                         }
                         <li class="page-item @(hasNextPage ? "" : "disabled")">
                             <a class="page-link" asp-action="Index"
                                asp-all-route-data="@Context.Request.Query.ToDictionary(q => q.Key, q => q.Value.ToString())"
                                asp-route-PageIndex="@(Model.PageIndex + 1)"
                                aria-label="Next">
                                 <span aria-hidden="true">»</span>
                             </a>
                         </li>
                     </ul>
                 </nav>
            }
        </div>
    </div>
</div>


@* ============================ *@
@*        KHỐI @functions      *@
@* ============================ *@
@functions {
    // Helper để lấy tên hiển thị Enum
    string GetEnumDisplayName(Enum enumValue) {
         switch (enumValue) {
             case LoaiHinhCongViec.banthoigian: return "Bán thời gian";
             case LoaiHinhCongViec.thoivu: return "Thời vụ";
             case LoaiHinhCongViec.linhhoatkhac: return "Linh hoạt khác";
             // Thêm các trường hợp khác nếu cần
             default: return enumValue.ToString();
         }
    }

     // Bỏ hàm RenderFilterAccordionItem đi vì đã viết HTML trực tiếp
}


@* ============================ *@
@*        PHẦN SCRIPTS         *@
@* ============================ *@
@section Scripts {
    @* Giữ nguyên phần script như bạn đã cung cấp *@
    <script>
        $(document).ready(function () {
            // --- Load Quận/Huyện khi chọn Thành phố ---
            const thanhPhoSelect = $('#thanhPhoFilter');
            const quanHuyenSelect = $('#quanHuyenFilter');
             // FIX CS8602: Thêm kiểm tra null hoặc dùng giá trị mặc định
            const initialQuanHuyenId = '@(Model.SelectedQuanHuyenId ?? 0)';

            function loadQuanHuyen(thanhPhoId, selectedQuanHuyenId) {
                if (thanhPhoId && thanhPhoId > 0) {
                    quanHuyenSelect.prop('disabled', true).html('<option value="">-- Đang tải... --</option>');
                    $.ajax({
                        url: '@Url.Action("GetQuanHuyenByThanhPho", "DiaChi", new { area = "" })',
                        type: 'GET',
                        data: { thanhPhoId: thanhPhoId },
                        success: function (data) {
                            quanHuyenSelect.empty().append('<option value="">-- Chọn Quận/Huyện --</option>');
                            if (data && data.length > 0) {
                                $.each(data, function (index, item) {
                                    quanHuyenSelect.append($('<option>', {
                                        value: item.id,
                                        text: item.ten
                                    }));
                                });
                                quanHuyenSelect.prop('disabled', false);
                                // Chuyển selectedQuanHuyenId thành chuỗi để so sánh với value của option
                                if (selectedQuanHuyenId && selectedQuanHuyenId != '0') {
                                    quanHuyenSelect.val(selectedQuanHuyenId);
                                }
                            } else {
                                quanHuyenSelect.append('<option value="" disabled>Không có quận/huyện</option>');
                                quanHuyenSelect.prop('disabled', true);
                            }
                        },
                        error: function (xhr, status, error) {
                            console.error("Lỗi khi tải quận/huyện:", error);
                            quanHuyenSelect.html('<option value="">-- Lỗi tải dữ liệu --</option>').prop('disabled', true);
                        }
                    });
                } else {
                    quanHuyenSelect.empty().append('<option value="">-- Chọn Quận/Huyện --</option>').prop('disabled', true);
                }
            }

            thanhPhoSelect.on('change', function () {
                loadQuanHuyen($(this).val(), null);
            });

            const initialThanhPhoId = thanhPhoSelect.val();
            if (initialThanhPhoId && initialThanhPhoId > 0) {
                loadQuanHuyen(initialThanhPhoId, initialQuanHuyenId);
            }

            $('#reset-filter-btn').on('click', function() {
                 window.location.href = '@Url.Action("Index", "TimViec")';
            });

            $('.btn-save-job').on('click', function(e){
                 e.preventDefault();
                 const button = $(this);
                 const jobId = button.data('job-id');
                 const isSaved = button.hasClass('active') || button.hasClass('btn-danger');

                 if (!jobId) return;
                 if (!@User.Identity.IsAuthenticated.ToString().ToLower()) {
                    // FIX CS1061: Sửa lại cách lấy URL
                    window.location.href = '@Url.Action("DangNhap", "TaiKhoan", new { area="", returnUrl = Context.Request.Path + Context.Request.QueryString })';
                    return;
                 }


                 button.prop('disabled', true);
                 const icon = button.find('i');
                 const textSpan = button.find('.save-text');
                 const originalIconClass = icon.attr('class');
                 const originalText = textSpan.text();

                 icon.removeClass().addClass('fas fa-spinner fa-spin');
                 textSpan.text('...');

                 $.ajax({
                     url: '@Url.Action("ToggleSaveJob", "ViecLam", new { area = "UngVien" })',
                     type: 'POST',
                     data: {
                         tinTuyenDungId: jobId,
                         __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                     },
                     success: function(response) {
                         if(response.success) {
                             if(response.isSaved) {
                                 button.removeClass('btn-outline-danger').addClass('btn-danger active');
                                 icon.removeClass().addClass('fas fa-bookmark');
                                 textSpan.text('Đã lưu');
                                 button.attr('title', 'Bỏ lưu');
                             } else {
                                 button.removeClass('btn-danger active').addClass('btn-outline-danger');
                                 icon.removeClass().addClass('far fa-bookmark');
                                 textSpan.text('Lưu');
                                  button.attr('title', 'Lưu tin');
                             }
                         } else {
                             console.error("Lỗi lưu tin:", response.message);
                             alert(response.message || "Có lỗi xảy ra, vui lòng thử lại.");
                             icon.removeClass().addClass(originalIconClass);
                             textSpan.text(originalText);
                         }
                     },
                     error: function(xhr, status, error) {
                          console.error("Lỗi AJAX:", error);
                         alert("Lỗi kết nối, vui lòng thử lại.");
                         icon.removeClass().addClass(originalIconClass);
                         textSpan.text(originalText);
                     },
                     complete: function() {
                         button.prop('disabled', false);
                     }
                 });
             });

        });
    </script>
}