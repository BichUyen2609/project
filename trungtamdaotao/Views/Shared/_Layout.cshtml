                    <address>
                        <i class="bi bi-geo-alt"></i> 123 Đường ABC, Quận XYZ, TP.HCM<br />
                        <i class="bi bi-telephone"></i> <a class="text-white-50" href="tel:+84123456789">0123 456 789</a><br />
