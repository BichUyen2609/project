@model IEnumerable<trungtamdaotao.Models.Course>
@{
    ViewData["Title"] = "Quản Lý Khóa Học";
    Layout = "_AdminLayout";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Quản Lý Khóa Học</h1>
        <a asp-action="CreateCourse" class="btn btn-primary">
            <i class="fas fa-plus-circle"></i> Thêm Khóa Học Mới
        </a>
    </div>

    <div class="card shadow">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="thead-dark">
                        <tr>
                            <th>Mã Khóa Học</th>
                            <th>Tên Khóa Học</th>
                            <th>Giảng Viên</th>
                            <th>Ngày Khai Giảng</th>
                            <th>Học Phí</th>
                            <th>Số Lượng HV</th>
                            <th>Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var course in Model)
                        {
                            <tr>
                                <td>@course.CourseCode</td>
                                <td>@course.CourseName</td>
                                <td>@course.Instructor</td>
                                <td>@course.StartDate.ToString("dd/MM/yyyy")</td>
                                <td>@course.TuitionFee.ToString("N0") VNĐ</td>
                                <td>
                                    @{
                                        var registeredStudents = course.CourseRegistrations?.Count ?? 0;
                                    }
                                    @registeredStudents/@course.MaxStudents
                                </td>
                                <td>
                                    <div class="btn-group">
                                        <a asp-action="CourseDetails" asp-route-id="@course.CourseId" class="btn btn-sm btn-info">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="EditCourse" asp-route-id="@course.CourseId" class="btn btn-sm btn-warning">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="DeleteCourse" asp-route-id="@course.CourseId" class="btn btn-sm btn-danger">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    
    <div class="mt-3">
        <a asp-action="Dashboard" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Quay Lại Bảng Điều Khiển
        </a>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Enable DataTables for better table functionality
            $('table').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.10.25/i18n/Vietnamese.json'
                },
                "pageLength": 10
            });
        });
    </script>
}