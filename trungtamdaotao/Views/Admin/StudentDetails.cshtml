@* Views/Admin/StudentDetails.cshtml *@
@model trungtamdaotao.Models.ApplicationUser
@{
    ViewData["Title"] = "Chi tiết học viên";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Chi tiết học viên</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Dashboard">Trang chủ</a></li>
        <li class="breadcrumb-item"><a asp-action="Students">Quản lý học viên</a></li>
        <li class="breadcrumb-item active">Chi tiết học viên</li>
    </ol>

    <div class="row">
        <div class="col-xl-6">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-user me-1"></i>
                    Thông tin học viên
                </div>
                <div class="card-body">
                    <div class="mb-3 row">
                        <label class="col-sm-4 col-form-label fw-bold">Họ tên:</label>
                        <div class="col-sm-8">
                            <p class="form-control-plaintext">@Model.FullName</p>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label class="col-sm-4 col-form-label fw-bold">Email:</label>
                        <div class="col-sm-8">
                            <p class="form-control-plaintext">@Model.Email</p>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label class="col-sm-4 col-form-label fw-bold">Số điện thoại:</label>
                        <div class="col-sm-8">
                            <p class="form-control-plaintext">@Model.PhoneNumber</p>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label class="col-sm-4 col-form-label fw-bold">Ngày sinh:</label>
                        <div class="col-sm-8">
                            <p class="form-control-plaintext">@(Model.BirthDate?.ToString("dd/MM/yyyy") ?? "N/A")</p>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label class="col-sm-4 col-form-label fw-bold">Ngày tạo tài khoản:</label>
                        <div class="col-sm-8">
                            <p class="form-control-plaintext">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                    </div>
                    <div class="mb-3 row">
                        <label class="col-sm-4 col-form-label fw-bold">ID:</label>
                        <div class="col-sm-8">
                            <p class="form-control-plaintext">@Model.Id</p>
                        </div>
                    </div>
                    <div class="d-flex mt-3">
                        <a asp-action="EditStudent" asp-route-id="@Model.Id" class="btn btn-primary me-2">
                            <i class="fas fa-edit"></i> Chỉnh sửa
                        </a>
                        <a asp-action="Students" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Quay lại
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-6">
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-graduation-cap me-1"></i>
                    Các khóa học đã đăng ký
                </div>
                <div class="card-body">
                    @if (Model.CourseRegistrations != null && Model.CourseRegistrations.Any())
                    {
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Tên khóa học</th>
                                    <th>Ngày đăng ký</th>
                                    <th>Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var registration in Model.CourseRegistrations.OrderByDescending(r => r.RegistrationDate))
                                {
                                    <tr>
                                        <td>
                                            <a asp-action="CourseDetails" asp-route-id="@registration.CourseId">
                                                @registration.Course.CourseName
                                            </a>
                                        </td>
                                        <td>@registration.RegistrationDate.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>
                                            @if (registration.IsCanceled)
                                            {
                                                <span class="badge bg-danger">Đã hủy</span>
                                                <small class="d-block text-muted">@registration.CancelDate?.ToString("dd/MM/yyyy")</small>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">Đang học</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i> Học viên chưa đăng ký khóa học nào.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>