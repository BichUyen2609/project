@model trungtamdaotao.Models.Course
@{
    ViewData["Title"] = "Thêm Khóa Học Mới";
    Layout = "_AdminLayout";
}

<div class="container-fluid mt-4">
    <h1 class="mb-4">Thêm Khóa Học Mới</h1>

    <div class="card shadow">
        <div class="card-body">
            <form asp-action="CreateCourse" asp-controller="Admin" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="CourseCode" class="font-weight-bold">Mã Khóa Học</label>
                            <input asp-for="CourseCode" class="form-control" required maxlength="20" />
                            <span asp-validation-for="CourseCode" class="text-danger"></span>
                            <small class="form-text text-muted">Nhập mã khóa học (tối đa 20 ký tự)</small>
                        </div>
                        
                        <div class="form-group">
                            <label asp-for="CourseName" class="font-weight-bold">Tên Khóa Học</label>
                            <input asp-for="CourseName" class="form-control" required maxlength="100" />
                            <span asp-validation-for="CourseName" class="text-danger"></span>
                            <small class="form-text text-muted">Nhập tên đầy đủ của khóa học</small>
                        </div>
                        
                        <div class="form-group">
                            <label asp-for="Instructor" class="font-weight-bold">Giảng Viên</label>
                            <input asp-for="Instructor" class="form-control" maxlength="100" />
                            <span asp-validation-for="Instructor" class="text-danger"></span>
                            <small class="form-text text-muted">Nhập tên giảng viên phụ trách</small>
                        </div>
                    </div>
                    
                    <div class="col-md-6">
                        <div class="form-group">
                            <label asp-for="StartDate" class="font-weight-bold">Ngày Khai Giảng</label>
                            <input asp-for="StartDate" type="date" class="form-control" required />
                            <span asp-validation-for="StartDate" class="text-danger"></span>
                            <small class="form-text text-muted">Chọn ngày khai giảng khóa học</small>
                        </div>
                        
                        <div class="form-group">
                            <label asp-for="TuitionFee" class="font-weight-bold">Học Phí (VNĐ)</label>
                            <input asp-for="TuitionFee" type="number" class="form-control" min="0" step="1000" required />
                            <span asp-validation-for="TuitionFee" class="text-danger"></span>
                            <small class="form-text text-muted">Nhập học phí cho khóa học</small>
                        </div>
                        
                        <div class="form-group">
                            <label asp-for="MaxStudents" class="font-weight-bold">Số Lượng Học Viên Tối Đa</label>
                            <input asp-for="MaxStudents" type="number" class="form-control" min="1" required />
                            <span asp-validation-for="MaxStudents" class="text-danger"></span>
                            <small class="form-text text-muted">Nhập số lượng học viên tối đa có thể tham gia</small>
                        </div>
                    </div>
                </div>
                
                <div class="form-group mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Lưu Khóa Học
                    </button>
                    <a asp-action="Courses" class="btn btn-secondary">
                        <i class="fas fa-times"></i> Hủy
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        // Set default date to tomorrow
        $(document).ready(function() {
            var tomorrow = new Date();
            tomorrow.setDate(tomorrow.getDate() + 1);
            
            var dateString = tomorrow.toISOString().split('T')[0];
            $('#StartDate').val(dateString);
        });
    </script>
}